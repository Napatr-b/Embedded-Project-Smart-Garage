# VITE_* เปิดเผยต่อ browser ไม่ใช่ที่เก็บ secret
VITE_DEVICE_ID=garage-01
VITE_MQTT_URL=
# ร่างเสนอทีม: กรอก URL WSS และตกลง topics/ACL ก่อนใช้
VITE_MQTT_TELEMETRY_TOPIC=draft/smart-garage/garage-01/telemetry
VITE_MQTT_STATUS_TOPIC=draft/smart-garage/garage-01/status
VITE_MQTT_COMMAND_TOPIC=draft/smart-garage/garage-01/command
VITE_MQTT_ACK_TOPIC=draft/smart-garage/garage-01/ack
VITE_MQTT_EVENT_TOPIC=draft/smart-garage/garage-01/event
